{
  "name": "llm-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "fmt": "oxfmt .",
    "lint": "oxfmt --check . && oxlint .",
    "deploy": "npm run build && echo 'Static files ready in build/ directory'",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "svelte": "^5.55.4",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@google/genai": "^2.13.0",
    "bits-ui": "^2.18.1",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.7",
    "marked-highlight": "^2.2.4",
    "openai": "^6.46.0",
    "temml": "^0.13.3"
  },
  "patchedDependencies": {
    "temml@0.13.3": "patches/temml@0.13.3.patch"
  }
}
